{
  "name": "@inixiative/foundry-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "archive": "bun run packages/foundry/src/archives/cli.ts",
    "kingdom": "bun run packages/foundry/src/providers/kingdom-cli.ts",
    "test": "bun test ./packages/core/tests/ && bun test ./packages/foundry/tests/*.test.ts && bun test ./packages/foundry/tests/gates/ && bun test ./scripts/daemon/",
    "test:core": "bun test ./packages/core/tests/",
    "test:foundry": "bun test ./packages/foundry/tests/*.test.ts",
    "test:browser": "bun test ./packages/foundry/tests/browser/",
    "test:db": "DATABASE_URL=postgresql://postgres:postgres@localhost:5932/foundry_test bun test ./packages/foundry/tests/db/ --max-concurrency=1",
    "test:live": "bun run scripts/vcr/live.ts",
    "test:live:daemon": "bun run scripts/vcr/daemon-smoke.ts",
    "test:live:api": "bun test --env-file=.env --env-file=.env.local ./packages/foundry/tests/live/",
    "vcr:refresh": "bun run scripts/vcr/refresh.ts",
    "vcr:accept": "bun run scripts/vcr/accept.ts",
    "test:all": "bun run test && bun run test:db",
    "typecheck": "bun run typecheck:core && bun run typecheck:foundry && bun run typecheck:scripts && bun run typecheck:browser",
    "typecheck:core": "bun run --cwd packages/core typecheck",
    "typecheck:foundry": "bun run --cwd packages/foundry typecheck",
    "typecheck:scripts": "tsc --noEmit",
    "typecheck:browser": "tsc --noEmit -p tsconfig.browser.json",
    "check": "bun run typecheck && bun run lint && bun run test",
    "start": "bun run packages/foundry/src/start.ts",
    "dev": "bun --watch run packages/foundry/src/start.ts",
    "viewer": "bun run packages/foundry/src/viewer/server.ts",
    "daemon:install": "bun run scripts/daemon/control.ts install",
    "daemon:uninstall": "bun run scripts/daemon/control.ts uninstall",
    "daemon:start": "bun run scripts/daemon/control.ts start",
    "daemon:stop": "bun run scripts/daemon/control.ts stop",
    "daemon:status": "bun run scripts/daemon/control.ts status",
    "daemon:logs": "tail -f \"$HOME/Library/Logs/foundry/foundry.out.log\"",
    "demo": "bun run packages/foundry/src/demo.ts",
    "db:push": "bunx prisma db push",
    "db:push:test": "DATABASE_URL=postgresql://postgres:postgres@localhost:5932/foundry_test bunx prisma db push",
    "setup": "bun run packages/foundry/src/setup.ts",
    "doctor": "bun run packages/foundry/src/doctor.ts",
    "team": "bun run packages/foundry/src/development-team-cli.ts",
    "archive:viewer": "bun run packages/foundry/src/archives/viewer.ts",
    "signet": "bun run packages/foundry/src/providers/signet-cli.ts",
    "lint": "biome check .",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi"
  },
  "devDependencies": {
    "@prisma/client": "6",
    "@types/bun": "1.4.2",
    "prisma": "6",
    "typescript": "6.0.3",
    "@biomejs/biome": "2.5.2",
    "@inixiative/config": "^0.5.56",
    "lefthook": "2.1.9"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  }
}
