{
  "name": "@inixiative/foundry",
  "version": "0.5.10",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./providers": "./src/providers/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./viewer": "./src/viewer/index.ts",
    "./tools": "./src/tools/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./classify": "./src/classify/index.ts",
    "./kingdom": "./src/kingdom/index.ts",
    "./headless-host": "./src/conversations/headless-host.ts",
    "./headless-host/protocol": "./src/conversations/headless-host-protocol.ts",
    "./client": "./src/client/index.ts",
    "./daemon": "./src/daemon/index.ts",
    "./repeats": "./src/feedback/repeats-cli.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test tests/*.test.ts",
    "pretest:db": "DATABASE_URL=postgresql://postgres:postgres@localhost:5932/foundry_test bunx prisma db push --skip-generate",
    "test:db": "DATABASE_URL=postgresql://postgres:postgres@localhost:5932/foundry_test bun test tests/db/ --max-concurrency=1",
    "test:all": "bun run test && bun run test:db",
    "typecheck": "bun run --bun tsc --noEmit",
    "start": "bun run src/start.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.92",
    "@inixiative/agent-session": "^0.12.0",
    "@inixiative/archive": "^0.33.0",
    "@inixiative/config": "^0.5.203",
    "@inixiative/foundry-core": "workspace:*",
    "@inixiative/gloss": "0.1.1",
    "@inixiative/json-rules": "^3.21.0",
    "@inixiative/signet": "^0.14.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@muse-code/sdk": "1.4.14",
    "@prisma/client": "^6.6.0",
    "hono": "^4.7.0",
    "marked": "^18.2.0",
    "mermaid": "^12.3.0",
    "prisma": "^6.6.0",
    "uuidv7": "^1.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "playwright": "^1.63.0"
  },
  "description": "Foundry: the opinionated agent harness built on @inixiative/foundry-core — providers, session adapters, the viewer and the daemon",
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inixiative/foundry.git",
    "directory": "packages/foundry"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "bin": {
    "foundry": "src/cli.ts"
  }
}
